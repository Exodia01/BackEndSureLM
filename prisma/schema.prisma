generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  keycloakId   String        @unique
  email        String        @unique
  name         String
  avatar       String?
  role         Role          @default(AGENT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  agentProfile AgentProfile?
  documents    Document[]
  leads        PolicyLead[]
  sessions     Session[]
}

model AgentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bankCustomerId String?
  location       String?
  language       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PolicyLead {
  id                 String              @id @default(cuid())
  agentId            String
  householdName      String
  phone              String?
  income             Int?
  familySize         Int?
  status             LeadStatus          @default(NEW)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  dateOfBirth        DateTime?
  followUpAt         DateTime?
  birthdayReminders  BirthdayReminder[]
  checklistInstances ChecklistInstance[]
  documentScans      DocumentScan[]
  messages           Message[]
  issuances          PolicyIssuance[]
  agent              User                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reminders          Reminder[]

  @@unique([agentId, phone])
  @@index([agentId, status, followUpAt])
  @@index([status])
  @@index([followUpAt])
  @@index([agentId, createdAt])
}

model PolicyIssuance {
  id             String         @id @default(cuid())
  leadId         String
  policyName     String
  policyProvider String?
  premiumAmount  Int?
  issuedAt       DateTime       @default(now())
  expiresAt      DateTime?
  status         IssuanceStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  nextPremiumDue DateTime?
  lead           PolicyLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Message {
  id        String      @id @default(cuid())
  leadId    String
  role      MessageRole
  content   String
  policies  Json?
  createdAt DateTime    @default(now())
  lead      PolicyLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Reminder {
  id          String       @id @default(cuid())
  leadId      String
  type        ReminderType
  scheduledAt DateTime
  note        String?
  isDone      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  lead        PolicyLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([scheduledAt])
}

model BirthdayReminder {
  id          String     @id @default(cuid())
  leadId      String
  name        String
  phone       String?
  dateOfBirth DateTime
  daysUntil   Int
  isToday     Boolean    @default(false)
  wishSent    Boolean    @default(false)
  refreshedAt DateTime   @default(now())
  lead        PolicyLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Document {
  id               String            @id @default(cuid())
  filename         String
  source           String?
  metadata         Json?
  version          Int               @default(1)
  scanStatus       UploadStatus      @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  uploadedById     String
  householdId      String?
  chunks           Chunk[]
  uploadedBy       User              @relation(fields: [uploadedById], references: [id])
  validationLogs   ValidationLog[]
  validationReport ValidationReport?
}

model Brochure {
  id           String         @id @default(cuid())
  basename     String
  originalName String
  pdfData      Bytes
  currentPage  Int            @default(0)
  totalPages   Int
  status       BrochureStatus @default(PENDING)
  versionHash  String?
  versionNum   Int            @default(1)
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Log          BrochureLog[]
  chunks       Chunk[]
}

model BrochureLog {
  id         String         @id @default(cuid())
  brochureId String
  versionNum Int
  action     BrochureAction
  metadata   Json?
  timestamp  DateTime       @default(now())
  brochure   Brochure       @relation(fields: [brochureId], references: [id])
}

model Chunk {
  id         String    @id @default(cuid())
  documentId String?
  brochureId String?
  content    String
  chunkOrder Int
  pageNumber Int?
  category   String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  brochure   Brochure? @relation(fields: [brochureId], references: [id])
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkOrder])
  @@index([brochureId, chunkOrder])
}

model ValidationLog {
  id            String           @id @default(cuid())
  documentId    String
  scanId        String?          @unique
  stage         ValidationStage
  status        ValidationStatus
  errorMsg      String?
  configuration Json?
  results       Json?
  timestamp     DateTime         @default(now())
  document      Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  scan          DocumentScan?    @relation(fields: [scanId], references: [id])

  @@index([documentId, timestamp])
  @@index([scanId, timestamp])
}

model OrchestrationLog {
  id                  String                  @id @default(cuid())
  workflowId          String                  @unique
  type                String
  status              String
  input               Json
  intermediateResults Json?                   @map("intermediate_results")
  finalOutput         Json?                   @map("final_output")
  agentsExecuted      Json                    @map("agents_executed")
  errors              Json?
  createdAt           DateTime                @default(now())
  completedAt         DateTime?
  AgentLogs           OrchestrationAgentLog[]
}

model OrchestrationAgentLog {
  id               String           @id @default(cuid())
  workflowId       String
  agent            String
  status           String
  input            Json?            @map("input_data")
  output           Json?            @map("output_data")
  latencyMs        Int?
  createdAt        DateTime         @default(now())
  orchestrationLog OrchestrationLog @relation(fields: [workflowId], references: [workflowId], onDelete: Cascade)
}

model Product {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  insurer              String
  type                 ProductType
  version              Int                   @default(1)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  checklistInstances   ChecklistInstance[]
  requirementTemplates RequirementTemplate[]

  @@index([insurer, type])
}

model RequirementTemplate {
  id                         String                      @id @default(cuid())
  productId                  String
  version                    Int
  sourceFile                 String?
  compiledAt                 DateTime                    @default(now())
  compilerVersion            String
  checklistInstances         ChecklistInstance[]
  requirementCompilerReports RequirementCompilerReport[]
  items                      RequirementItem[]
  product                    Product                     @relation(fields: [productId], references: [id])

  @@unique([productId, version])
  @@index([productId])
}

model RequirementItem {
  id              String                  @id @default(cuid())
  templateId      String
  groupId         String
  groupLabel      String
  groupOrder      Int
  itemId          String
  docType         DocumentType
  label           String
  isPreferred     Boolean?                @default(false)
  itemOrder       Int
  ruleSet         Json?
  selectionPolicy String                  @default("ONE_OF")
  minRequired     Int                     @default(1)
  maxAllowed      Int?
  checklistItems  ChecklistItemInstance[]
  scanRecords     DocumentScan[]
  template        RequirementTemplate     @relation(fields: [templateId], references: [id])

  @@index([templateId, groupId])
  @@index([docType])
}

model RequirementCompilerReport {
  id                   String              @id @default(cuid())
  templateId           String
  sourceFile           String
  parseWarnings        Json?
  confidence           Float
  reviewRequired       Boolean             @default(false)
  unknownDocumentTypes String[]
  itemsExtracted       Int
  groupsFound          Int
  compilerVersion      String
  compiledAt           DateTime            @default(now())
  template             RequirementTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId, compiledAt])
}

model ChecklistInstance {
  id                String                  @id @default(cuid())
  leadId            String
  templateId        String
  templateVersion   Int
  applicationData   Json?
  appliedAt         DateTime                @default(now())
  completedAt       DateTime?
  overallStatus     ChecklistStatus         @default(PENDING)
  invalidatedReason String?
  productId         String?
  lead              PolicyLead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product           Product?                @relation(fields: [productId], references: [id])
  template          RequirementTemplate     @relation(fields: [templateId], references: [id])
  items             ChecklistItemInstance[]

  @@index([leadId, appliedAt])
}

model ChecklistItemInstance {
  id              String            @id @default(cuid())
  instanceId      String
  itemId          String
  status          ChecklistStatus   @default(PENDING)
  uploadedDocId   String?           @unique
  validatedAt     DateTime?
  validatedBy     String?
  completionNotes String?
  skipped         Boolean           @default(false)
  skipReason      String?
  ruleErrors      Json?
  instance        ChecklistInstance @relation(fields: [instanceId], references: [id])
  requirement     RequirementItem   @relation(fields: [itemId], references: [id])
  document        DocumentScan?     @relation(fields: [uploadedDocId], references: [id])

  @@unique([itemId, instanceId])
  @@index([instanceId, status])
}

model DocumentScan {
  id                    String                 @id @default(cuid())
  leadId                String
  templateId            String?
  itemId                String?
  docType               DocumentType?
  status                UploadStatus           @default(PENDING)
  originalHash          String
  filename              String
  mimetype              String?
  sizeBytes             Int?
  ocrData               Json?
  extractedData         Json?
  uploadedAt            DateTime               @default(now())
  validatedAt           DateTime?
  validatedBy           String?
  requirementItemId     String?
  checklistItemInstance ChecklistItemInstance?
  lead                  PolicyLead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  requirementItem       RequirementItem?       @relation(fields: [requirementItemId], references: [id])
  validationLogs        ValidationLog?
  validationReport      ValidationReport?

  @@index([leadId, status])
  @@index([templateId, itemId])
}

model ValidationReport {
  id              String        @id @default(cuid())
  documentId      String        @unique
  scanId          String?       @unique
  rulesPassed     Int
  rulesFailed     Int
  aiConfidence    Float?
  agentVerified   Boolean?
  validatedAt     DateTime?
  validatedBy     String?
  errors          Json?
  warnings        Json?
  overallStatus   UploadStatus? @default(PENDING)
  confidenceScore Float?
  extractedData   Json?
  discrepancies   Json?
  createdAt       DateTime      @default(now())
  document        Document      @relation(fields: [documentId], references: [id])
  scan            DocumentScan? @relation(fields: [scanId], references: [id])
}

model AuditTrail {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  keycloakUserId String   @unique
  accessToken    String
  refreshToken   String
  codeVerifier   String?
  state          String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keycloakUserId])
  @@index([expiresAt])
}

model AuthRateLimitLog {
  id        String   @id @default(cuid())
  ip        String
  action    String
  reason    String
  details   Json?
  timestamp DateTime @default(now())

  @@index([ip, action, timestamp])
}

enum ReminderType {
  FOLLOWUP
  BIRTHDAY
}

enum MessageRole {
  AGENT
  AI
}

enum Role {
  AGENT
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  POLICY_ISSUED
  REJECTED
}

enum IssuanceStatus {
  ACTIVE
  EXPIRED
  CLAIMED
}

enum DocumentType {
  KYC_AADHAAR_FRONT
  KYC_AADHAAR_BACK
  KYC_PAN
  KYC_ADDRESS
  KYC_BANK_STATEMENT
  KYC_INCOME_PROOF
}

enum UploadStatus {
  PENDING
  UPLOADED
  PROCESSING
  VALIDATED
  REJECTED
  SKIPPED
}

enum ChecklistStatus {
  PENDING
  UPLOADED
  PROCESSING
  VALIDATED
  SKIPPED
  FAILED
  INVALIDATED
}

enum BrochureStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum BrochureAction {
  UPLOAD
  VERSION_CREATED
  PROCESS_START
  PROCESS_COMPLETE
  FAILED
}

enum ValidationStage {
  OCR_COMPLETED
  EXTRACTION_COMPLETED
  RULE_VALIDATED
  AI_VERIFICATION
}

enum ValidationStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

enum ProductType {
  TERM_INSURANCE
  ENDOWMENT_PLANS
  MONEYBACK_PLANS
  ULIP
  PENSION_PLANS
  HEALTH_INSURANCE
  MICRO_INSURANCE
  SINGLE_PREMIUM
}

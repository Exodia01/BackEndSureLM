generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  name          String
  avatar        String?
  role          Role     @default(AGENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agentProfile  AgentProfile?
  leads         PolicyLead[]
}

model AgentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankCustomerId String?
  location       String?
  language       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PolicyLead {
  id            String           @id @default(cuid())
  agentId       String
  agent         User             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  householdName String
  phone         String?
  income        Int?
  familySize    Int?
  messages      Message[]
  status        LeadStatus       @default(NEW)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  dateOfBirth   DateTime?
  followUpAt    DateTime?
  reminders     Reminder[]
  birthdayReminders BirthdayReminder[]
  issuances     PolicyIssuance[]

  @@unique([agentId, phone])
  @@index([agentId, status, followUpAt])
  @@index([status])
  @@index([followUpAt])
  @@index([agentId, createdAt])
}

model PolicyIssuance {
  id             String          @id @default(cuid())
  leadId         String
  lead           PolicyLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  policyName     String
  policyProvider String?
  premiumAmount  Int?
  issuedAt       DateTime        @default(now())
  expiresAt      DateTime?
  status         IssuanceStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  nextPremiumDue DateTime?

  @@index([leadId])
}

model Message {
  id        String      @id @default(cuid())
  leadId    String
  lead      PolicyLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  policies  Json?
  createdAt DateTime    @default(now())

  @@index([leadId, createdAt])
}

model Reminder {
  id          String       @id @default(cuid())
  leadId      String
  lead        PolicyLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        ReminderType
  scheduledAt DateTime
  note        String?
  isDone      Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([leadId])
  @@index([scheduledAt])
}

model BirthdayReminder {
  id            String     @id @default(cuid())
  leadId        String
  lead          PolicyLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  dateOfBirth   DateTime
  daysUntil     Int
  isToday       Boolean    @default(false)
  wishSent      Boolean    @default(false)
  refreshedAt   DateTime   @default(now())

  @@index([leadId])
}

model Document {
  id           String     @id @default(cuid())
  filename     String
  source       String?
  metadata     Json?
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  chunks       Chunk[]
}

model Brochure {
  id           String         @id @default(cuid())
  basename     String         // e.g., "Kotak_Premier_Life_Plan"
  originalName String         // Full filename with version info
  pdfData      Bytes          // Store raw PDF in DB (BYTEA)
  currentPage  Int            @default(0)
  totalPages   Int
  status       BrochureStatus @default(PENDING)
  versionHash  String?        // MD5 for deduplication across versions
  versionNum   Int            @default(1)
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  chunks       Chunk[]
  Log          BrochureLog[]
}

model BrochureLog {
  id           String         @id @default(cuid())
  brochureId   String
  brochure     Brochure       @relation(fields: [brochureId], references: [id])
  
  versionNum   Int            // Version number at time of log
  action       BrochureAction
  metadata     Json?          // {pages: 45, chunks: 128, error: "..."}
  timestamp    DateTime       @default(now())
}

model Chunk {
  id            String   @id @default(cuid())
  documentId    String?
  brochureId    String?
  document      Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  brochure      Brochure? @relation(fields: [brochureId], references: [id])
  content       String
  chunkOrder    Int
  pageNumber    Int?
  category      String?    // Header/section detection for Qdrant payload
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([documentId, chunkOrder])
  @@index([brochureId, chunkOrder])
}

enum ReminderType {
  FOLLOWUP
  BIRTHDAY
}

enum MessageRole {
  AGENT
  AI
}

enum Role {
  AGENT
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  POLICY_ISSUED
  REJECTED
}

enum IssuanceStatus {
  ACTIVE
  EXPIRED
  CLAIMED
}

enum BrochureStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum BrochureAction {
  UPLOAD
  VERSION_CREATED
  PROCESS_START
  PROCESS_COMPLETE
  FAILED
}

model OrchestrationLog {
  id               String   @id @default(cuid())
  workflowId       String   @unique
  type             String
  status           String
  input            Json
  intermediateResults Json? @map("intermediate_results")
  finalOutput      Json?    @map("final_output")
  agentsExecuted   Json     @map("agents_executed")
  errors           Json?
  createdAt        DateTime @default(now())
  completedAt      DateTime?

  AgentLogs OrchestrationAgentLog[]
}

model OrchestrationAgentLog {
  id          String   @id @default(cuid())
  workflowId  String
  agent       String
  status      String
  input       Json?    @map("input_data")
  output      Json?    @map("output_data")
  latencyMs   Int?
  createdAt   DateTime @default(now())

  orchestrationLog OrchestrationLog @relation(fields: [workflowId], references: [workflowId], onDelete: Cascade)
}
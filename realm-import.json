{
  "id": "surelm_realm",
  "realm": "surelm_realm",
  "alias": "surelm_realm",
  "displayName": "SureLM Realm",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>SureLM</span></div>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  " bruteForceProtected": false,
  "permanentLockout": false,
  "maximumCredentialsForDays": 0,
  "waitingInputSeconds": 0,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "failFast": false,
  "internationalizationEnabled": true,
  "defaultLocale": "en",
  "supportedLocales": ["en", "hi", "mr", "bn", "ta", "te"],
  "localeSelectorConfig": {
    "allowUserMigration": true,
    "cookieName": "KC_LANGUAGE"
  },
  "browserSecurityHeaders": {
    "contentSecurityPolicyReportOnly": null,
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "xXSSProtection": "1; mode=block",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "smtpServer": {
    "starttlsEnabled": false,
    "auth": false
  },
  "loginTheme": "keycloak",
  "accountTheme": "keycloak",
  "adminTheme": "keycloak",
  "emailTheme": "keycloak",
  "parInitiatorType": "none",
  "OAuth2DeviceExpirationMins": 15,
  "OAuth2DevicePollingInterval": 5,
  "clientAuthenticatorTypes": null,
  "defaultRole": {
    "id": "0c1b947f-8e3d-4f8a-9b2a-4c5d6e7f8a9b",
    "name": "default-role",
    "description": "${client_default_role}",
    "composite": true,
    "clientRole": false
  },
  "defaultGroups": [],
  "roles": {
    "realm": [
      {
        "id": "admin-role-id",
        "name": "admin",
        "description": "Realm administrator role",
        "composite": true,
        "clientRole": false
      },
      {
        "id": "user-role-id",
        "name": "user",
        "description": "Standard user role",
        "composite": true,
        "clientRole": false
      }
    ],
    "client": {
      "realm-management": [
        {
          "id": "manage-users",
          "name": "manage-users",
          "description": "${role_manage-users}",
          "composite": false,
          "clientRole": true
        },
        {
          "id": "view-users",
          "name": "view-users",
          "description": "${role_view-users}",
          "composite": false,
          "clientRole": true
        },
        {
          "id": "manage-realm",
          "name": "manage-realm",
          "description": "${role_manage-realm}",
          "composite": false,
          "clientRole": true
        }
      ],
      "security-admin-console": [],
      "admin-cli": [],
      "account-console": [],
      "web-app": []
    }
  },
  "clients": [
    {
      "clientId": "web-app",
      "name": "SureLM Web Application",
      "description": "Web application client for SureLM platform",
      "enabled": true,
      "type": "public",
      "authorizationServicesEnabled": false,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "web-app",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jwt.payload claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "preferred username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "name",
            "jsonType.label": "String"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "profile", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "admin-cli",
      "name": "Admin CLI",
      "enabled": true,
      "type": "bearer-only",
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false
    },
    {
      "clientId": "security-admin-console",
      "name": "Security Admin Console",
      "enabled": true,
      "type": "legacy",
      "publicClient": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "redirectUris": ["/admin/*"]
    }
  ],

# Database Configuration
DATABASE_URL=postgresql://admin:[REDACTED-CREDENTIAL]@localhost:5432/surelm

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333

# Ollama API Configuration
# Use native Ollama endpoints: http://localhost:11434
# DO NOT include /v1 suffix - it causes 404 errors
OLLAMA_HOST=http://127.0.0.1:11434

# Model Names
PRIMARY_MODEL_NAME=qwen2.5-coder:1.5b
FALLBACK_MODEL_NAME=llama3:latest

# Keycloak Configuration
KEYCLOAK_URL=https://localhost:18443/auth
KEYCLOAK_REALM=surelm_realm
KEYCLOAK_CLIENT_ID=web-app
ADMIN_REALM_ROLE=admin
AGENT_REALM_ROLE=agent

# Initial Admin User (LOCAL DEV DEFAULTS - MUST BE OVERRIDDEN IN PRODUCTION)
# These are insecure defaults ONLY for local development!
INITIAL_ADMIN_USERNAME=admin-user
INITIAL_ADMIN_PASSWORD=[REDACTED-CREDENTIAL]
INITIAL_ADMIN_EMAIL=admin@surelm.com

# Production REQUIREMENTS:
# - INITIAL_ADMIN_PASSWORD must be at least 12 characters with mixed case, numbers, and symbols
# - Use a password manager or secrets vault for production credentials
# - Never commit passwords to source control
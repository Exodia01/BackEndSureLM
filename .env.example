# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/surelm

# ─── Vector Store (Qdrant) ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=policy_knowledge

# ─── Ollama ─────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_CTX=32768

# ─── Models ─────────────────────────────────────────────────────────────────
PRIMARY_MODEL_NAME=qwen2.5:7b
FALLBACK_MODEL_NAME=llama3.1:8b
EXTRACTION_MODEL=qwen2.5:7b
VISION_MODEL=minicpm-v
VISION_FALLBACK=llava:7b

# ─── Keycloak (server-side) ─────────────────────────────────────────────────
KEYCLOAK_URL=https://localhost:18444/auth
KEYCLOAK_REALM=surelm_0_realm
KEYCLOAK_CLIENT_ID=web-app
ADMIN_REALM_ROLE=admin
AGENT_REALM_ROLE=agent

# ─── Keycloak (client-side — exposed to browser) ────────────────────────────
NEXT_PUBLIC_KEYCLOAK_URL=https://localhost:18444/auth
NEXT_PUBLIC_KEYCLOAK_REALM=surelm_0_realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=web-app

# ─── Keycloak Bootstrap (admin API) ─────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PWD=CHANGEME

# ─── Initial Admin User ─────────────────────────────────────────────────────
INITIAL_ADMIN_USERNAME=admin-user
INITIAL_ADMIN_PASSWORD=CHANGEME
INITIAL_ADMIN_EMAIL=admin@surelm.com

# ─── Session ────────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong secret before deployment. Example:
#   openssl rand -hex 32
SESSION_SECRET=  # set this to a real secret — never use a literal value here

# ─── Application ────────────────────────────────────────────────────────────
# NODE_ENV=development
# LOG_LEVEL=info
# PDF_STORAGE_DIR=./data/pdfs

# ─── Integration Test Keycloak Credentials ──────────────────────────────────
# Must match the KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD in docker-compose.yml
# TEST_USERNAME=CHANGEME
# TEST_PASSWORD=CHANGEME

# ─── Observability (optional) ───────────────────────────────────────────────
# PHOENIX_PROJECT_NAME=surelm-platform
# PHOENIX_ENDPOINT=http://localhost:6007
# OPENTELEMETRY_EXPORTER_OTLP_ENDPOINT=http://localhost:44317/v1/traces

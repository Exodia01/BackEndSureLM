# Database Configuration
DATABASE_URL=postgresql://admin:localpg2024@localhost:5432/surelm

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333

# Ollama API Configuration
# Use native Ollama endpoints: http://localhost:11434
# DO NOT include /v1 suffix - it causes 404 errors
OLLAMA_HOST=http://127.0.0.1:11434

# Model Names
PRIMARY_MODEL_NAME=qwen2.5-coder:1.5b
FALLBACK_MODEL_NAME=llama3:latest

# OCR Models (for Document Verification Subsystem)
OCR_PRIMARY_MODEL=minicpm-v
OCR_FALLBACK_MODEL=llava:7b

# Storage Backend Configuration
STORAGE_BACKEND=s3  # or minio for local development
S3_ORIGINALS_BUCKET=surelm-documents-originals
S3_PROCESSED_BUCKET=surelm-documents-processed
AWS_REGION=us-east-1

# Phoenix Observability (OpenCode integration)
PHOENIX_PROJECT_NAME=surelm-platform
PHOENIX_ENDPOINT=http://localhost:6007

# Ollama Configuration for Windows
# ==================================
# 
# On Windows, Ollama may fail to bind to 127.0.0.1 due to port restrictions.
# Use one of these approaches:
#
# Option 1: Use localhost (recommended if 127.0.0.1 doesn't work):
OLLAMA_HOST=http://localhost:11434
#
# Option 2: Use 0.0.0.0 to bind on all interfaces:
# OLLAMA_HOST=http://0.0.0.0:11434
#
# Option 3: If using 127.0.0.1 and getting "access forbidden" error, try:
# - Run PowerShell as Administrator
# - Or use localhost instead

OLLAMA_HOST=http://localhost:11434

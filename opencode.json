{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "testing": {
      "description": "Test Orchestrator - runs unit, integration, e2e tests and validates",
      "tasks": ["unit", "integration", "e2e", "validate"]
    },
    "orchestrator": {
      "description": "Orchestration Pipeline Tester - handles pipeline, workflow, and rag-validation tasks"
    }
  },
  "command": {
    "test:unit": {
      "template": "npx vitest run test/unit/*.test.ts --reporter=verbose",
      "description": "Run unit tests"
    },
    "test:integration": {
      "template": "npx vitest run test/integration/*.test.ts --reporter=verbose",
      "description": "Run integration tests"
    },
    "test:e2e": {
      "template": "npx vitest run test/e2e/*.test.ts --reporter=verbose",
      "description": "Run end-to-end tests"
    },
    "test:orchestrator": {
      "template": "npx vitest run test/unit/orchestrator.test.ts test/integration/orchestrator-pipeline.test.ts test/e2e/orchestrator-e2e.test.ts",
      "description": "Run orchestrator tests"
    },
    "test:all": {
      "template": "npx vitest run --reporter=verbose",
      "description": "Run all tests"
    },
    "validate:rag": {
      "template": "tsx scripts/validate-rag.mts",
      "description": "Validate RAG pipeline"
    }
  }
}
